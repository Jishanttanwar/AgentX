# AgentX Backend Environment Configuration

# Application Settings
APP_NAME="AgentX"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# Security & CORS
SECRET_KEY="agentx-secret-key-change-in-production"
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# LLM Providers (Avoid hardcoding model names)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"
OPENAI_TEMPERATURE=0.2

# Search Provider
TAVILY_API_KEY="your-tavily-api-key-here"

# Database Settings
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/agentx"

# Vector Store
CHROMA_PERSIST_DIRECTORY="./chroma_data"

# Cache & Message Broker
REDIS_URL="redis://localhost:6379/0"

# Workflow Limits & Safeguards
MAX_SEARCH_RESULTS_PER_TASK=5
MAX_REVISION_CYCLES=3
MAX_CONCURRENT_RESEARCHERS=4
WORKFLOW_TIMEOUT_SECONDS=600

